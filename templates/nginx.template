server {
    listen 80;
    server_name ${USER_DOMAIN} www.${USER_DOMAIN};

    # Override standard Nginx 1MB limitation to accommodate heavy documentation transfers into RAG storage
    client_max_body_size 500M;

    location / {
        root /var/www/${USER_DOMAIN_FLAT};
        index index.html;
        try_files $uri $uri/ =404;
    }

    location = /ai {
        return 301 /ai/;
    }

    location /ai/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:${USER_JELLYFIN_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_buffering off;
    }
}
