server {
    listen 80;
    server_name ${USER_DOMAIN} www.${USER_DOMAIN};

    # Allow large uploads for RAG document ingestion
    client_max_body_size 500M;

    # ── Landing page (astrophotography timelapse + nav links) ──
    location = / {
        root /var/www/${USER_DOMAIN_FLAT};
        try_files /index.html =404;
    }

    location / {
        root /var/www/${USER_DOMAIN_FLAT};
        index index.html;
        try_files $uri $uri/ =404;
    }

    # ── AI / Open WebUI ──
    # Points to the local Open WebUI instance at 127.0.0.1:8080
    location /ai/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # ── Jellyfin media server ──
    # Points to the local Jellyfin instance at 127.0.0.1:8096
    location /media/ {
        proxy_pass http://127.0.0.1:${USER_JELLYFIN_PORT}/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
